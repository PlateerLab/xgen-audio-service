# ─────────────────────────────────────────────────────────────────────────────
#  Deploy profile: 5090-200-server
#  2× NVIDIA RTX 5090 (32 GB each · sm_120 Blackwell) — 최대 자원 사용
#
#    GPU 0  →  OmniVoice (TTS)
#    GPU 1  →  Whisper   (STT)
#    각 서비스가 GPU 하나를 독점 → GPU 메모리 0.9 목표
#
#  사용:
#    docker compose --env-file deploy/5090-200-server.env up --build -d
#    docker compose --env-file deploy/5090-200-server.env ps
#    docker compose --env-file deploy/5090-200-server.env logs -f
#  (또는 `cp deploy/5090-200-server.env .env` 후 평소대로 `docker compose up --build -d`)
# ─────────────────────────────────────────────────────────────────────────────

# ── Published host ports (XGEN 카탈로그 base_url 이 가리킬 곳) ────────────────
OMNIVOICE_HOST_PORT=9881
WHISPER_HOST_PORT=8001

# ── GPU 분리 (각 서비스가 물리 GPU 하나 독점) ────────────────────────────────
OMNIVOICE_GPU_ID=0
WHISPER_GPU_ID=1

# ── OmniVoice (TTS) — GPU 0, 최대치 ──────────────────────────────────────────
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DTYPE=float16
# GPU 독점이므로 메모리 0.9. (RTX 5090 32GB → ~29GB)
OMNIVOICE_GPU_MEMORY_FRACTION=0.9
# 최고 품질(32) — 자원 충분. 더 빠르게: 24(균형)/8~12(최속).
OMNIVOICE_DEFAULT_NUM_STEP=32
# 큐 depth ↑ (GPU 작업은 직렬이지만 파이프라이닝으로 처리량 향상). 5090 이면 4~6.
OMNIVOICE_MAX_CONCURRENCY=4
OMNIVOICE_SHM_SIZE=16G
OMNIVOICE_LOG_LEVEL=info

# ── Whisper (STT) — GPU 1, 최대치 ────────────────────────────────────────────
WHISPER_MODEL=openai/whisper-large-v3
# GPU 독점 → 메모리 0.9 (KV 캐시 대폭 확보 → 동시 전사 처리량 ↑)
WHISPER_GPU_MEMORY_FRACTION=0.9
WHISPER_DTYPE=auto
# ⚠️ sm_120(RTX 50xx) + 최신 vLLM: 백엔드 자동 선택 권장. 강제 TRITON_ATTN 이
#    최신 스택에서 엔진 코어 초기화를 깨는 원인. 문제 지속 시 FLASH_ATTN/FLASHINFER 시도.
WHISPER_ATTENTION_BACKEND=auto
WHISPER_ENFORCE_EAGER=1          # whisper-large-v3 는 작아 eager 로 충분. compile 스톨 회피.
WHISPER_TENSOR_PARALLEL=1        # 단일 GPU. 모델이 작아 샤딩 불필요.
WHISPER_SHM_SIZE=8G
# vLLM 이미지 태그. RTX 5090 은 최신이 최적 → latest 유지. 특정 버전 회귀 시 핀 고정:
#   WHISPER_VLLM_TAG=v0.11.0
WHISPER_VLLM_TAG=latest

# ── HuggingFace (모델 다운로드) ──────────────────────────────────────────────
HF_ENDPOINT=https://huggingface.co
# HUGGINGFACE_HUB_TOKEN=
