# xgen-audio-service — copy to .env and edit for your GPU box.
#
# Ready-made profiles in deploy/ (use with --env-file):
#   • 2× RTX 5090 (GPU0=TTS, GPU1=STT, 0.9 mem, max):
#       docker compose --env-file deploy/5090-200-server.env up --build -d

# ── Published host ports (what XGEN connects to) ─────────────────────────────
OMNIVOICE_HOST_PORT=9881
WHISPER_HOST_PORT=8001

# ── GPU assignment ───────────────────────────────────────────────────────────
# Pin each service to a physical GPU id. Defaults put BOTH on GPU 0 (safe on any
# box — they split VRAM via the *_GPU_MEMORY_FRACTION knobs below).
#
#   • 1 GPU  : leave both 0 and keep fractions ~0.65 / ~0.35.
#   • 2 GPUs : OMNIVOICE_GPU_ID=0  WHISPER_GPU_ID=1  (each owns a GPU → raise
#              fractions to ~0.85 each).
#   • 3+ GPUs: use deploy/gpu-pool.example.yml (omnivoice replicas + LB).
OMNIVOICE_GPU_ID=0
WHISPER_GPU_ID=0

# ── OmniVoice (TTS) ──────────────────────────────────────────────────────────
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DTYPE=float16
OMNIVOICE_MAX_CONCURRENCY=2         # queue depth (GPU work is serialised)
OMNIVOICE_DEFAULT_NUM_STEP=24       # 32 best · 24 balanced · 8-12 fastest
OMNIVOICE_GPU_MEMORY_FRACTION=0.65  # ~0.85 when omnivoice owns a whole GPU
OMNIVOICE_LOG_LEVEL=info
# OMNIVOICE_SHM_SIZE=8G

# ── Whisper (STT) ────────────────────────────────────────────────────────────
WHISPER_MODEL=openai/whisper-large-v3
WHISPER_GPU_MEMORY_FRACTION=0.35    # ~0.85 when whisper owns a whole GPU
WHISPER_DTYPE=auto
# Attention backend: 'auto' lets vLLM pick (recommended on latest vLLM + sm_120).
# Forcing TRITON_ATTN was an old workaround (pre-sm_120-FA2 binaries) and can now
# break engine-core init on new stacks. Alternatives: FLASH_ATTN, FLASHINFER.
WHISPER_ATTENTION_BACKEND=auto
WHISPER_ENFORCE_EAGER=1             # 0 → allow torch.compile (perf) on new GPUs
WHISPER_TENSOR_PARALLEL=1           # >1 shards across GPUs (needs that many visible)
# WHISPER_VLLM_TAG=latest           # pin the vLLM base image tag (e.g. v0.11.0) for reproducibility
# WHISPER_MAX_MODEL_LEN=448
# WHISPER_SHM_SIZE=4G

# ── HuggingFace (model downloads) ────────────────────────────────────────────
HF_ENDPOINT=https://huggingface.co
# HUGGINGFACE_HUB_TOKEN=
